    "test:core": "TZ=Europe/Berlin vitest run --coverage --reporter=default",
    "typecheck": "tsc --noEmit -p .",
    "ci:local": "node scripts/ci-local.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "benchmark:runtime": "node scripts/benchmark-runtime.mjs",
    "benchmark:runtime:compare": "node scripts/compare-runtime-benchmarks.mjs",
    "benchmark:runtime:upgrade": "node scripts/benchmark-runtime-upgrade.mjs",
    "test:e2e:offline": "playwright test e2e/offline-resilience.spec.ts",
    "release:prepare": "pnpm build:blog-images && pnpm build",
    "build": "pnpm runtime-env:validate && pnpm test:core && pnpm flags:sync && pnpm inspirations:images:optimize && pnpm blog:images:optimize && pnpm build:image-placeholders && pnpm pwa:icons && pnpm og:site:build && pnpm og:site:validate && pnpm i18n:validate && pnpm routes:validate && pnpm supabase:validate && pnpm plans:validate-sync && pnpm updates:validate && pnpm toasts:validate && pnpm storage:validate && pnpm blog:validate && pnpm edge:validate && pnpm climate:validate && pnpm sitemap:generate && pnpm build:example-previews && vite build && pnpm prerender:validate && pnpm pwa:sw",
    "build:netlify": "pnpm runtime-env:validate && pnpm flags:sync && pnpm inspirations:images:optimize && pnpm blog:images:optimize && pnpm build:image-placeholders && pnpm pwa:icons && pnpm og:site:build && pnpm og:site:validate && pnpm i18n:validate && pnpm routes:validate && pnpm supabase:validate && pnpm plans:validate-sync && pnpm updates:validate && pnpm toasts:validate && pnpm storage:validate && pnpm blog:validate && pnpm edge:validate && pnpm climate:validate && pnpm sitemap:generate && pnpm build:example-previews && vite build && pnpm prerender:validate && pnpm pwa:sw",
    "preview": "node scripts/serve-built-site.mjs",
    "prerender:validate": "tsx scripts/validate-public-prerenders.ts",
    "maps:generate": "tsx scripts/generate-trip-maps.ts",
    "maps:routes:generate": "tsx scripts/generate-country-route-maps.ts",
    "routes:stops:resolve": "tsx scripts/resolve-country-route-stops.ts",
    "trips:enrich-locations": "tsx scripts/enrich-trip-city-locations.ts",
    "airports:generate": "tsx scripts/generate-airports-reference.ts",
    "countries:search:generate": "tsx scripts/generate-country-search-metadata.ts",
    "climate:generate": "tsx scripts/generate-country-climate-normals.ts",
    "countries:map:generate": "tsx scripts/generate-country-map-geometry.ts",
    "climate:validate": "tsx scripts/validate-country-climate.ts",
    "destinations:import": "tsx scripts/import-destination-guides.ts && pnpm destinations:split",
    "destinations:split": "node scripts/split-destination-guides.mjs",
    "destinations:validate": "tsx scripts/validate-destination-guides.ts",
    "routes:validate": "tsx scripts/validate-country-routes.ts",
    "destinations:sync": "tsx scripts/sync-destination-guides.ts",
    "destinations:sources:import": "tsx scripts/import-atobeach-country-sources.ts",
    "ai:eval": "tsx scripts/run-ai-eval.ts",
    "ai:eval:ci": "tsx scripts/run-ai-eval.ts --ci",
    "ai:eval:security": "tsx scripts/run-ai-eval.ts --pack security",
    "ai:eval:security:ci": "tsx scripts/run-ai-eval.ts --pack security --ci",
    "doctor": "npx react-doctor@latest",
    "trip-agent:dry-run": "tsx --env-file=.env.local scripts/trip-agent-dry-run.ts",
    "pwa:icons": "tsx scripts/build-pwa-icons.ts",
    "pwa:sw": "node scripts/build-service-worker.mjs",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts"
  },

    "lz-string": "1.5.0",
    "mapbox-gl": "^3.20.0",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.4.3",
    "react": "19.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "19.3.1",
    "react-i18next": "^16.5.4",
    "react-is": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
